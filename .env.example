SERPAPI_API_KEY=
OPENROUTER_API_KEY=

# One token, or several separated by commas. Spaces around the commas are fine.
#   APIFY_API_TOKEN=apify_api_aaa,apify_api_bbb
#
# Each token is one Apify account, and each account allows a fixed number of
# concurrent actor runs (5 on the free plan). The Apify services share one
# global pool backed by Postgres, so N tokens means N*5 runs at once across
# every service -- adding an account is just appending a token here.
#
# A token that reports an empty wallet is parked for 15 minutes and skipped by
# the other services, rather than each of them rediscovering it. Note that a
# drained pay-per-result account answers HTTP 400, not 402, which is why that
# classification keys off the error type and not the status alone.
APIFY_API_TOKEN=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# --- web/ dashboard ---
# scripts/serve-web.js reads these and generates config.js at request time,
# so the browser never needs to know them at build time.

# levelup_ai — serves /api/v1/product-research/* and /api/v1/ai/*
LEVELUP_API_BASE=https://research-data-ai.relipasoft.com
# niche-research-service (Go, port 8084). Empty = unused.
NICHE_API_BASE=
# Port the dev server listens on
WEB_PORT=5500
