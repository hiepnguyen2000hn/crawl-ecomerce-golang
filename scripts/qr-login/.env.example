# Copy to .env and adjust as needed.
# true/1  -> headless Chromium (no display, e.g. VPS)
# false/0 -> headed Chromium (opens a visible browser window)
PLAYWRIGHT_HEADLESS=true

# CloakBrowser humanized mouse/keyboard/scroll behavior (Bezier curves, timing jitter).
CLOAKBROWSER_HUMANIZE=true

# Optional: route through a proxy, e.g. http://user:pass@host:port or socks5://host:port
CLOAKBROWSER_PROXY=
