# Crawl settings for allegro.pl

# chrome       = real Google Chrome driven by Playwright. Measured to get past
#                DataDome on this machine, even with navigator.webdriver=true.
# cloakbrowser = stealth Chromium. Currently BLOCKED on the free v146 binary --
#                run `cloakbrowser login` for the free v152 before trying it.
ENGINE=chrome

# MUST be false for Allegro. Measured: headed Chrome passes DataDome, headless
# Chrome is blocked -- same machine, same IP, same binary. Needs a DISPLAY; on
# a headless server run the whole thing under `xvfb-run`.
PLAYWRIGHT_HEADLESS=false

# Humanized mouse/keyboard/scroll. ENGINE=cloakbrowser only.
CLOAKBROWSER_HUMANIZE=true

# Optional. Leave empty to go direct -- the direct path is the one that works.
# Format: http://user:pass@host:port
PROXY=

# Session reuse: a storage_state written by `--solve`, relative to this dir.
SESSION_FILE=session.json

# Leave EMPTY unless PROXY actually exits in Poland. Claiming pl-PL /
# Europe/Warsaw from a Vietnamese IP is a fingerprint contradiction, not a
# disguise -- that was in the first version of this script and it got blocked.
LOCALE=
TIMEZONE=

NAV_TIMEOUT_MS=60000
# Pause per settle attempt while the page redirects through ?dd_referrer=.
SETTLE_MS=3000
# How many settle attempts before giving up on a page.
LOAD_RETRIES=10
# Pause between listing pages -- don't hammer it.
PAGE_DELAY_MS=2500
