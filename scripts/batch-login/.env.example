# Copy to .env and adjust for the target site's login form.

# --- Login page / form selectors (CSS selectors, Playwright syntax) ---
LOGIN_URL=https://example.com/login
USERNAME_SELECTOR=input[name="username"]
PASSWORD_SELECTOR=input[name="password"]
SUBMIT_SELECTOR=button[type="submit"]

# Optional: for two-step forms where the password field only appears after
# clicking "Next" on the email/username page (Microsoft/Google-style).
# Leave blank for ordinary single-page forms.
USERNAME_NEXT_SELECTOR=

# Optional: some providers (e.g. Microsoft) show a "verify your email" /
# pick-a-method screen instead of the password field. If a selector here
# matches, it's clicked to fall back to password login. Best-effort --
# ignored if it never appears.
USE_PASSWORD_SELECTOR=

# Optional: a post-login interstitial to dismiss if present (e.g. a "Stay
# signed in?" prompt). Best-effort -- ignored if it never appears.
POST_LOGIN_DISMISS_SELECTOR=

# How to detect a successful login. Provide at least one:
# - substring that must appear in the post-login URL
SUCCESS_URL_CONTAINS=/dashboard
# - OR a selector that must become visible after login (leave blank if unused)
SUCCESS_SELECTOR=

# --- Runtime behavior ---
# true/1  -> headless Chromium (no display, e.g. VPS)
# false/0 -> headed Chromium (opens a visible browser window, useful for
#            debugging selectors against one account first)
PLAYWRIGHT_HEADLESS=true

# CloakBrowser humanized mouse/keyboard/scroll behavior (Bezier curves, timing jitter).
CLOAKBROWSER_HUMANIZE=true

# How many browsers to run concurrently. Keep modest (CPU/RAM + proxy
# pool + target site rate limits) -- 100 accounts does NOT mean 100 at once.
CONCURRENCY=5

# Navigation / form-submit timeout per step, in ms.
NAV_TIMEOUT_MS=30000

# Seconds to wait for the success indicator after submitting the form.
LOGIN_CONFIRM_TIMEOUT_SECONDS=20

# Skip accounts that already have a saved session in ./sessions/<username>.json
# (set to false/0 to force a fresh login for every account).
SKIP_IF_SESSION_EXISTS=true
