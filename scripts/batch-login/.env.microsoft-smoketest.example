# Worked example: smoke-test the script's fill/click/wait-for-success
# mechanics against login.microsoftonline.com's real selectors.
#
# This is for verifying the SCRIPT works, not for logging into Microsoft at
# scale -- use it with exactly ONE account you own, CONCURRENCY=1,
# PLAYWRIGHT_HEADLESS=false (so you can watch it), and accounts.csv
# containing a single row. Do not point this file at a real target with
# 100 rows -- swap LOGIN_URL/selectors to the actual site you have 100
# accounts on and use .env.example for that instead.
#
# cp .env.microsoft-smoketest.example .env

LOGIN_URL=https://login.microsoftonline.com/

# Step 1: email field, then a "Next" button that reveals the password step.
USERNAME_SELECTOR=input[name="loginfmt"]
# Microsoft serves two different login UIs (classic, which uses
# id="idSIButton9" on its Next/Sign-in button; and a newer modern UI which
# doesn't use that id at all). This selector list matches either, in order.
USERNAME_NEXT_SELECTOR=#idSIButton9, button:has-text("Next"), input[type="submit"][value="Next"]

# Some accounts get a "Verify your email" / pick-a-method interstitial here
# instead of the password field (offers "Send code" by default). Click
# "Use your password" to fall back to the normal password flow. Best-effort
# -- ignored if the password field shows up directly instead.
USE_PASSWORD_SELECTOR=text="Use your password"

# Step 2: password field + submit button (same classic-vs-modern UI caveat
# as USERNAME_NEXT_SELECTOR above -- button may say "Next" or "Sign in"
# depending on which UI Microsoft serves).
PASSWORD_SELECTOR=input[name="passwd"]
SUBMIT_SELECTOR=#idSIButton9, button:has-text("Next"), button:has-text("Sign in"), input[type="submit"][value="Next"], input[type="submit"][value="Sign in"]

# After a correct password, Microsoft shows a "Stay signed in?" interstitial
# before redirecting -- click "Yes" to get past it.
POST_LOGIN_DISMISS_SELECTOR=input[type="submit"][value="Yes"]

# Success indicator -- adjust to wherever YOUR account actually lands
# (e.g. https://account.microsoft.com/ or your org's portal). Watch the
# browser on the first run (headless=false) and copy the real post-login
# URL fragment here.
SUCCESS_URL_CONTAINS=account.microsoft.com

PLAYWRIGHT_HEADLESS=false
CLOAKBROWSER_HUMANIZE=true
CONCURRENCY=1
NAV_TIMEOUT_MS=30000
LOGIN_CONFIRM_TIMEOUT_SECONDS=30
SKIP_IF_SESSION_EXISTS=false
# Keep the browser open after each account (OK or FAILED) until you press
# Enter in the terminal, instead of auto-closing. Only applies when headed.
HOLD_BROWSER_OPEN=true
