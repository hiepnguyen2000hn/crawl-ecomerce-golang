syntax = "v1"

type CreateTrendJobRequest {
	Keyword string `json:"keyword"`
	Geo     string `json:"geo,optional"`
}

type CreateTrendJobResponse {
	JobId string `json:"job_id"`
}

type GetTrendJobRequest {
	Id string `path:"id"`
}

type GetTrendJobResponse {
	Status   string `json:"status"`
	Keyword  string `json:"keyword"`
	AiOutput string `json:"ai_output"`
}

type CreateFbAdsJobRequest {
	Query        string   `json:"query,optional"`
	PageId       string   `json:"page_id,optional"`
	Country      string   `json:"country,optional"`
	Category     string   `json:"category,optional"`
	MediaType    string   `json:"media_type,optional"`
	SortBy       string   `json:"sort_by,optional"`
	ActiveStatus string   `json:"active_status,optional"`
	MinDate      string   `json:"min_date,optional"`
	MaxDate      string   `json:"max_date,optional"`
	MaxItems     int      `json:"max_items,optional"`
	Advertisers  []string `json:"advertisers,optional"`
	FetchDetails bool     `json:"fetch_details,optional"`
}

type CreateFbAdsJobResponse {
	JobId string `json:"job_id"`
}

type GetFbAdsJobRequest {
	Id string `path:"id"`
}

type GetFbAdsJobResponse {
	Status   string `json:"status"`
	AdCount  int32  `json:"ad_count"`
	AiOutput string `json:"ai_output"`
}

type CreateAmazonJobRequest {
	Keyword  string   `json:"keyword,optional"`
	Urls     []string `json:"urls,optional"`
	Country  string   `json:"country,optional"`
	MaxItems int      `json:"max_items,optional"`
}

type CreateAmazonJobResponse {
	JobId string `json:"job_id"`
}

type GetAmazonJobRequest {
	Id string `path:"id"`
}

type GetAmazonJobResponse {
	Status       string `json:"status"`
	ProductCount int32  `json:"product_count"`
	AiOutput     string `json:"ai_output"`
}

type CreateChina1688JobRequest {
	Keywords []string `json:"keywords,optional"`
	OfferIds []string `json:"offer_ids,optional"`
	MaxItems int      `json:"max_items,optional"`
}

type CreateChina1688JobResponse {
	JobId string `json:"job_id"`
}

type GetChina1688JobRequest {
	Id string `path:"id"`
}

type GetChina1688JobResponse {
	Status       string `json:"status"`
	ProductCount int32  `json:"product_count"`
	AiOutput     string `json:"ai_output"`
}

type CreateRedditJobRequest {
	Keyword string `json:"keyword"`
}

type CreateRedditJobResponse {
	JobId string `json:"job_id"`
}

type GetRedditJobRequest {
	Id string `path:"id"`
}

type GetRedditJobResponse {
	Status       string `json:"status"`
	PostCount    int32  `json:"post_count"`
	CommentCount int32  `json:"comment_count"`
	AiOutput     string `json:"ai_output"`
}

type CreateRedditApiJobRequest {
	Keyword string `json:"keyword"`
}

type CreateRedditApiJobResponse {
	JobId string `json:"job_id"`
}

type GetRedditApiJobRequest {
	Id string `path:"id"`
}

type GetRedditApiJobResponse {
	Status       string `json:"status"`
	PostCount    int32  `json:"post_count"`
	CommentCount int32  `json:"comment_count"`
	AiOutput     string `json:"ai_output"`
}

service gateway-api {
	@handler CreateTrendJob
	post /jobs/trend (CreateTrendJobRequest) returns (CreateTrendJobResponse)

	@handler GetTrendJob
	get /jobs/trend/:id (GetTrendJobRequest) returns (GetTrendJobResponse)

	@handler CreateFbAdsJob
	post /jobs/fbads (CreateFbAdsJobRequest) returns (CreateFbAdsJobResponse)

	@handler GetFbAdsJob
	get /jobs/fbads/:id (GetFbAdsJobRequest) returns (GetFbAdsJobResponse)

	@handler CreateAmazonJob
	post /jobs/amazon (CreateAmazonJobRequest) returns (CreateAmazonJobResponse)

	@handler GetAmazonJob
	get /jobs/amazon/:id (GetAmazonJobRequest) returns (GetAmazonJobResponse)

	@handler CreateChina1688Job
	post /jobs/china1688 (CreateChina1688JobRequest) returns (CreateChina1688JobResponse)

	@handler GetChina1688Job
	get /jobs/china1688/:id (GetChina1688JobRequest) returns (GetChina1688JobResponse)

	@handler CreateRedditJob
	post /jobs/reddit (CreateRedditJobRequest) returns (CreateRedditJobResponse)

	@handler GetRedditJob
	get /jobs/reddit/:id (GetRedditJobRequest) returns (GetRedditJobResponse)

	@handler CreateRedditApiJob
	post /jobs/reddit-api (CreateRedditApiJobRequest) returns (CreateRedditApiJobResponse)

	@handler GetRedditApiJob
	get /jobs/reddit-api/:id (GetRedditApiJobRequest) returns (GetRedditApiJobResponse)
}

